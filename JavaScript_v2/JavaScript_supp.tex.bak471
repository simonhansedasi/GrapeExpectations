\toprule
 & \multicolumn{2}{c}{\textbf{Euclidean}} & \multicolumn{2}{c}{\textbf{Mahalanobis}} \\
\cmidrule(lr){2-3}\cmidrule(lr){4-5}
\textbf{Threshold} & \textbf{Cells} & \textbf{Factor} & \textbf{Cells} & \textbf{Factor} \\
\midrule
90th percentile            & 504  & 13.7$\times$ & 114 & 60.7$\times$ \\
92.5th percentile          & 816  &  8.5$\times$ & 165 & 42.0$\times$ \\
