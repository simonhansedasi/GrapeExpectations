}

% ROLE: secondary source, both for the trade-wind inversion mechanism
%        (subcloud/cloud/inversion/free-atmosphere layering) and as a
%        direct, independently-measured below-inversion lapse rate.
% VERIFIED 2026-07-26 (Simon pasted full text): DOI confirmed
%        (10.3354/cr001207). Study site is Haleakala on Maui (5-station
%        transect, 950-3,000 m), not Hawai'i Island -- caveat still stands,
%        cite primarily for the mechanism. BUT: paper directly reports a
%        measured lapse rate "of about 0.006 C/m [6.0 C/km] in December and
%        May" below ~1650 m (their fog-zone/inversion contact boundary),
%        reduced to 0.003-0.004 C/m within the inversion-influenced 1650-
%        2130 m band. 6.0 C/km is close to the 6.5 C/km ELR figure from
%        Kagawa-Viviani & Giambelluca (2020) above -- two independent
%        measurements agree.
@article{GiambellucaNullet1991,
  author  = {Giambelluca, Thomas W. and Nullet, Dennis},
  title   = {Influence of the trade-wind inversion on the climate of a
             leeward mountain slope in {H}awaii},
  journal = {Climate Research},
  year    = {1991},
  volume  = {1},
  pages   = {207--216},
  doi     = {10.3354/cr001207},
}

