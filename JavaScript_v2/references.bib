% ROLE: primary source for the fixed environmental lapse rate (-6.5 C/km
%        below the trade-wind inversion) used in the island-wide temperature
%        surface, replacing the pooled farm-cell regression (R^2=0.01, noise).
% VERIFIED 2026-07-26 (Simon pulled full text via AGU membership): DOI
%        confirmed (10.1029/2019JD031571), statewide incl. Hawai'i Island,
%        uses the ~2,150 m TWI breakpoint, elevation explains ~90% of
%        temperature variance in their 2006-2017 spatial model (Table 1).
%        Figure 5a labels their reference line "ELR: mean environmental
%        lapse rate, ~6.5 C/km" (vs. DALR 9.8 C/km dry adiabatic) -- this is
%        the exact number used in the manuscript, not just "consistent
%        with" it. Text also gives moist adiabatic ~5.5 C/km. Sea level
%        Tavg,z0 (statewide, Figure 3c) runs ~22-24 C over the 1905-2017
%        record, supporting the 24.0 C sea-level reference used here
%        (statewide series, not Kona-specific -- text in JavaScript.tex
%        should say "statewide" not "leeward coastal").
@article{KagawaVivianiGiambelluca2020,
  author  = {Kagawa-Viviani, Aurora K. and Giambelluca, Thomas W.},
  title   = {Spatial patterns and trends in surface air temperatures and
             implied changes in atmospheric moisture across the {H}awaiian
             {I}slands, 1905--2017},
  journal = {Journal of Geophysical Research: Atmospheres},
  year    = {2020},
  volume  = {125},
  number  = {2},
  pages   = {e2019JD031571},
